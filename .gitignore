# Binaries
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test / coverage
# NOTE: do not use a bare `coverage.*` glob here — it silently swallows Go
# source files named coverage.go (e.g. internal/blue/coverage/coverage.go).
# List the actual coverage *artifact* extensions instead.
*.test
*.out
coverage.html
coverage.txt
coverage.xml

# Engagement artifacts (NEVER commit real client data)
/engagements/
/loot/
/reports/
*.engagement.yaml
!configs/*.example.yaml
# self-owned CTF fixture, no real client data:
!proving-ground/*.engagement.yaml

# Audit logs (may contain sensitive target data)
*.audit.jsonl

# Local model / cache
.ollama/

# Transient server / setup logs (runtime artifacts)
serve-out.log
serve-err.log
wsl-setup.log

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Go
go.work
go.work.sum
vendor/

# Local go test tmp (AppLocker workaround)
/.gotmp/

.claude/worktrees/
