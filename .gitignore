# Binaries
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test / coverage
*.test
*.out
coverage.*

# Engagement artifacts (NEVER commit real client data)
/engagements/
/loot/
/reports/
*.engagement.yaml
!configs/*.example.yaml
# committed loopback demo — the quickstart target, loopback-only, no client data:
!configs/localhost.engagement.yaml
# self-owned CTF fixture, no real client data:
!proving-ground/*.engagement.yaml

# Audit logs (may contain sensitive target data)
*.audit.jsonl

# Local model / cache
.ollama/

# Transient server / setup logs (runtime artifacts)
serve-out.log
serve-err.log
wsl-setup.log

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Go
go.work
go.work.sum
vendor/

# Local go test tmp (AppLocker workaround)
/.gotmp/

.claude/worktrees/

# Engagement run state (resumable checkpoints written to the working dir)
*.state.json
